{
  "name": "create-release-action",
  "version": "4.0.0",
  "private": true,
  "description": "GitHub Action that creates a release and optionally posts release notes to Slack",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "husky"
  },
  "keywords": [
    "github-action",
    "release",
    "slack"
  ],
  "author": "Nuszpl Botond",
  "license": "ISC",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/action": "^8.0.4",
    "@octokit/request-error": "^7.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.4"
  }
}
